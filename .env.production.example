# Copy to .env.production and fill in every value below -- docker-compose.prod.yml
# refuses to boot (see backend/app/core/startup_checks.py) if any secret is
# still a placeholder, too short, or COOKIE_SECURE isn't true. See
# DEPLOYMENT.md for the full first-deploy walkthrough.

ENV=production

APP_NAME=BuscoMiPana

# Postgres -- generate a real password, don't reuse the local-dev one.
POSTGRES_USER=bmp
POSTGRES_PASSWORD=
POSTGRES_DB=buscomipana

# Redis (Celery broker + rate limiting)
REDIS_URL=redis://redis:6379/0

# Auth -- generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET and ADMIN_SESSION_SECRET must be DIFFERENT values -- they guard
# two different trust boundaries (API bearer tokens vs. the SQLAdmin session).
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=30
ADMIN_SESSION_SECRET=

# Same generation command as above.
ANALYTICS_PEPPER=
ANALYTICS_PEPPER_VERSION=1

# SMS gateway
SMS_GATEWAY=infobip
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER_ID=BuscoMiPana
# Same generation command as above -- configured as the shared secret on the
# Infobip inbound-forwarding rule's custom header (see DEPLOYMENT.md).
INFOBIP_WEBHOOK_SHARED_SECRET=
# Leave both blank to auto-provision on first use (see infobip_gateway.py) --
# once provisioned, the app logs the IDs it created; pin them here so a
# restart reuses that pair instead of provisioning a new one every time. To
# find existing ones later: GET {INFOBIP_BASE_URL}/2fa/2/applications and
# GET {INFOBIP_BASE_URL}/2fa/2/applications/{applicationId}/messages.
INFOBIP_2FA_APPLICATION_ID=
INFOBIP_2FA_MESSAGE_ID=

# Alternate SMS gateway -- set SMS_GATEWAY=twilio instead of infobip to use
# these. MessagingServiceSid takes precedence over a plain From number when
# both are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Admin bootstrap -- keep this list to exactly the phone number(s) that
# should become admin on first signup, and see DEPLOYMENT.md for why this
# should be tightened immediately after the real admin account exists.
ADMIN_PHONE_NUMBERS=

# Same public domain Caddy is serving (see ../Caddyfile) -- same-origin
# routing means the browser never needs a separate CORS-allowed origin, but
# this still gates non-browser/API clients.
FRONTEND_ORIGIN=https://your-domain.example
COOKIE_SECURE=true
# Only true if actually deployed behind Cloudflare (Tunnel or proxied DNS) --
# see backend/app/core/limiter.py.
TRUST_CLOUDFLARE_HEADERS=true

# Media storage -- local is fine for a first deploy, but has no redundancy
# and doesn't survive a host rebuild beyond the docker volume. Switch to s3
# (or an S3-compatible bucket) once real usage picks up.
MEDIA_STORAGE_BACKEND=local
MEDIA_MAX_UPLOAD_BYTES=8388608
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_ENDPOINT_URL=

# Used by Caddy (../Caddyfile) to know which domain to serve/request a cert for.
PUBLIC_DOMAIN=your-domain.example

# From the Cloudflare Zero Trust dashboard -- Networks > Tunnels > (create a
# tunnel) > install & run a connector > copy the token. See DEPLOYMENT.md.
CLOUDFLARE_TUNNEL_TOKEN=
