http://www.{$PUBLIC_DOMAIN} {
	redir https://{$PUBLIC_DOMAIN}{uri} permanent
}

http://{$PUBLIC_DOMAIN} {
	encode gzip

	# Everything the API owns lives under these paths on the SAME public
	# domain as the frontend -- deliberately, so the browser's requests are
	# same-origin (no CORS round-trip, no separate api.* domain/cert to
	# manage, and the CSP connect-src on both sides can just say 'self').
	@backend path /api/* /admin* /health /openapi.json /docs* /redoc*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:8080
	}
}
