# Environment: local | staging | production
ENV=local

# Display brand name -- used in the FastAPI title and OTP/notification SMS text
APP_NAME=Buscomipana

# Postgres
POSTGRES_USER=bmp
POSTGRES_PASSWORD=bmp_local_password
POSTGRES_DB=buscomipana
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bmp:bmp_local_password@postgres:5432/buscomipana

# Redis (Celery broker + rate limiting)
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-value
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Separate signing key for the SQLAdmin ops-panel session cookie -- must not
# be the same value as JWT_SECRET (see backend/app/main.py)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-value

# Analytics anonymization pepper (out-of-DB secret; rotate periodically)
ANALYTICS_PEPPER=change-me-to-a-long-random-value
ANALYTICS_PEPPER_VERSION=1

# SMS gateway: mock | infobip
SMS_GATEWAY=mock
INFOBIP_BASE_URL=https://xxxxxx.api.infobip.com
INFOBIP_API_KEY=
INFOBIP_SENDER_ID=Buscomipana
INFOBIP_WEBHOOK_SHARED_SECRET=change-me-to-a-long-random-value

# Admin bootstrap
ADMIN_PHONE_NUMBERS=+573000000000

# Browser cookie auth (see backend/app/api/v1/auth.py)
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Only set to true when the origin is verifiably unreachable except through
# Cloudflare (e.g. Cloudflare Tunnel with no published host ports) -- see
# backend/app/core/limiter.py and DEPLOYMENT.md.
TRUST_CLOUDFLARE_HEADERS=false

# Media storage: local | s3 (see backend/app/storage/)
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_PATH=/app/media
MEDIA_MAX_UPLOAD_BYTES=8388608
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_ENDPOINT_URL=
